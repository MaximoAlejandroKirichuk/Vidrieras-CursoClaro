---
import Vidriera from '../layouts/Vidriera.astro';
import SessionPicker from '../components/SessionPicker.astro';
import { oficios } from '../data/oficios';
import { fecha, pesos, planes, primeraCon } from '../lib/precios';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/oficios.css';

const intensive = oficios.catalogo.cursos.find((course) => course.id === 'intensivo-electricidad')!;
const intensivePlan = planes(intensive).find((plan) => plan.id === 'sena')!;
const firstSession = primeraCon(oficios, intensive.id);
const courses = oficios.catalogo.cursos.filter((course) => course.id !== intensive.id);
const questions = oficios.faq.filter((item) => !item.p.includes('efectivo'));
---
<Vidriera i={oficios}>
  <header class="bisagra-header demo-wrap">
    <a class="bisagra-brand" href="#contenido">
      <strong>Bisagra<span aria-hidden="true">.</span></strong>
      <span>Escuela de Oficios</span>
    </a>
    <nav aria-label="Navegación de Bisagra">
      <a href="#cursos">Cursos</a>
      <a href="#fechas">Fechas y sedes</a>
      <a href="#faq">Preguntas</a>
    </nav>
  </header>

  <main id="contenido" class="bisagra-main">
    <section id="cursos" class="bisagra-courses demo-wrap" aria-labelledby="courses-title">
      <div class="bisagra-intro">
        <h1 id="courses-title">Un oficio empieza en el taller.</h1>
        <p>Electricidad, barbería y uñas. Consultá qué se practica, qué incluye cada curso y cuándo podés empezar.</p>
      </div>

      <article class="bisagra-intensive" aria-labelledby="intensive-title">
        <div class="bisagra-sheet">
          <div class="bisagra-sheet-title">
            <h2 id="intensive-title">{intensive.nombre}</h2>
            <p>{intensive.resumen}</p>
          </div>
          <dl class="bisagra-specs">
            <div><dt>Duración</dt><dd>{intensive.duracion}</dd></div>
            <div><dt>Modalidad</dt><dd>{intensive.modalidad}</dd></div>
            <div><dt>Para empezar</dt><dd>{intensive.datos[0]}</dd></div>
            <div><dt>En el taller</dt><dd>{intensive.datos[1]}</dd></div>
          </dl>
          <div class="bisagra-included">
            <h3>Incluye</h3>
            <ul>{intensive.incluye.map((item) => <li>{item}</li>)}</ul>
          </div>
        </div>
        <div class="bisagra-reserve-strip">
          <div class="bisagra-next">
            <span>Próximo inicio disponible</span>
            {firstSession ? <><strong><time datetime={firstSession.inicio}>{fecha(firstSession.inicio)}</time></strong><span>{firstSession.sede} · {firstSession.horario} h</span></> : <strong>Consultá las próximas fechas</strong>}
          </div>
          <div class="bisagra-price">
            <span>Seña de {pesos(intensivePlan.hoy)}</span>
            <strong>Total {pesos(intensivePlan.total)}</strong>
            <span>Saldo: {pesos(intensivePlan.total - intensivePlan.hoy)} antes del inicio</span>
          </div>
          <a class="demo-button" href="#fechas" data-select-course={intensive.id}>Ver fechas del intensivo</a>
        </div>
      </article>

      <div class="bisagra-catalog-heading">
        <h2>Cursos para seguir aprendiendo</h2>
        <p>Compará duración, práctica y formas de pago.</p>
      </div>
      <div class="bisagra-catalog">
        {courses.map((course) => {
          const options = planes(course);
          const startingPlan = options[0];
          const cashPlan = options.find((plan) => plan.id === 'unico');
          const next = primeraCon(oficios, course.id);
          return <article class="bisagra-course" aria-labelledby={`title-${course.id}`}>
            <details>
              <summary>
                <h3 id={`title-${course.id}`}>{course.nombre}</h3>
                <span>{course.duracion} · {course.modalidad}</span>
                <span class="bisagra-detail-label">Contenido e incluidos</span>
              </summary>
              <div class="bisagra-course-content">
                <p>{course.resumen}</p>
                <ul>{[...course.datos, ...course.incluye].map((item) => <li>{item}</li>)}</ul>
                {course.precio.kit && <p class="bisagra-kit">Kit opcional: {pesos(course.precio.kit.monto)}. {course.precio.kit.detalle} Se elige por separado en la inscripción.</p>}
                <p>{startingPlan.detalle}</p>
                {cashPlan && <p>Pago único: {pesos(cashPlan.total)}.</p>}
              </div>
            </details>
            <div class="bisagra-course-booking">
              <p><strong>{startingPlan.id === 'sena' ? 'Seña' : 'Primera cuota'} {pesos(startingPlan.hoy)}</strong>
                <span>{next ? `Próximo inicio: ${fecha(next.inicio, false)}` : 'Consultá las próximas fechas'}</span></p>
              <a class="demo-link" href="#fechas" data-select-course={course.id} aria-label={`Ver fechas de ${course.nombre}`}>Ver fechas</a>
            </div>
          </article>;
        })}
      </div>
    </section>

    <section class="bisagra-reservation" aria-label="Selección de grupo e inscripción">
      <div class="demo-wrap">
        <div class="bisagra-reservation-note">
          <p>Primero el curso. Después, tu turno.</p>
          <p>Elegí una fecha y sede para ver las opciones de pago. La inscripción es una simulación: no se cobra ni se reserva un lugar real.</p>
        </div>
        <SessionPicker i={oficios} initialCourse="intensivo-electricidad" title="Elegí cuándo venir al taller" />
        <div class="bisagra-locations">
          <h3>Dónde se cursa</h3>
          <p>{oficios.direccion}</p>
          <span>Direcciones ficticias de esta demostración.</span>
        </div>
      </div>
    </section>

    <section id="faq" class="bisagra-faq demo-wrap" aria-labelledby="faq-title">
      <div class="bisagra-faq-intro">
        <h2 id="faq-title">Antes de venir</h2>
        <p>Herramientas, asistencia y certificados: las condiciones de los cursos de este ejemplo.</p>
      </div>
      <div class="demo-faq">
        {questions.map((item) => <details><summary>{item.p}</summary><p>{item.r}</p></details>)}
      </div>
    </section>
  </main>
</Vidriera>
