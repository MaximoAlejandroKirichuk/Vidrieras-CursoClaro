---
import type { Instituto } from '../data/tipos';
import { estado, fecha, planes, pesos } from '../lib/precios';
import { coursePath, referenceDate } from '../lib/funnel';

interface Props {
  i: Instituto;
  id?: string;
  title?: string;
  initialCourse?: string;
  initialGroup?: string;
  showCourseFilter?: boolean;
  showGroupFilter?: boolean;
  funnel?: boolean;
}

const { i, id = 'fechas', title = i.fechas.titulo, initialCourse = 'todos', initialGroup = 'todos', showCourseFilter = true, showGroupFilter = true, funnel = false } = Astro.props;
const groups = [...new Set(i.fechas.comisiones.map((session) => session.grupo))];
const sessions = [...i.fechas.comisiones].sort((a, b) => a.inicio.localeCompare(b.inicio));
const matches = (session: typeof sessions[number]) => (initialCourse === 'todos' || session.cursoId === initialCourse) && (initialGroup === 'todos' || session.grupo === initialGroup);
const count = sessions.filter(matches).length;
---
<section class="session-picker" id={id} data-session-picker aria-labelledby={`${id}-title`}>
  <div class="session-heading">
    <h2 id={`${id}-title`}>{title}</h2>
    <p>Fechas, precios y disponibilidad de ejemplo.</p>
  </div>
  <div class="session-filters">
    <label class:list={{ 'session-filter-hidden': !showCourseFilter }}>Curso
      <select data-session-course>
        <option value="todos" selected={initialCourse === 'todos'}>Todos los cursos</option>
        {i.catalogo.cursos.map((course) => <option value={course.id} selected={initialCourse === course.id}>{course.nombre}</option>)}
      </select>
    </label>
    <label class:list={{ 'session-filter-hidden': !showGroupFilter }}>{i.fechas.grupoRotulo}
      <select data-session-group>
        <option value="todos" selected={initialGroup === 'todos'}>Todas las opciones</option>
        {groups.map((group) => <option value={group} selected={initialGroup === group}>{group}</option>)}
      </select>
    </label>
    <p class="session-count" role="status" aria-live="polite" data-session-count>{count} {count === 1 ? 'grupo' : 'grupos'}</p>
  </div>
  <ul class="session-list">
    {sessions.map((session) => {
      const course = i.catalogo.cursos.find((item) => item.id === session.cursoId)!;
      const availability = estado(session);
      const price = planes(course)[0].hoy;
      return <li class="session-row" data-session-row data-course={session.cursoId} data-group={session.grupo} hidden={!matches(session)}>
        <div class="session-course"><h3>{session.titulo}</h3><span>{session.sede}</span></div>
        <div class="session-meta"><strong>{session.dias}</strong><span>{session.horario}</span></div>
        <div class="session-date"><time datetime={session.inicio}>Desde el {fecha(session.inicio, false)}</time><span>{session.cupos > 0 ? `${session.cupos} lugares` : availability.texto}</span></div>
        <div class="session-enroll"><span>{pesos(price)} <small>hoy</small></span>{funnel ? <a class="demo-button" data-track="course_click" data-course-id={course.id} href={`${coursePath(i, course)}?comision=${session.id}${session.cupos === 0 || session.inicio < referenceDate || course.cerrado ? '#proxima-fecha' : ''}`}>Ver curso</a> : <button class="demo-button" data-inscribir={session.id} disabled={session.cupos === 0} aria-label={`${session.cupos > 0 ? 'Elegir grupo de' : 'Sin lugares en'} ${session.titulo}, ${session.dias}, ${session.horario}, ${session.sede}`}>{session.cupos > 0 ? 'Elegir grupo' : 'Sin lugares'}</button>}</div>
      </li>;
    })}
  </ul>
  <div class="session-empty" data-session-empty hidden={count > 0}>
    <p>No hay grupos para esta combinación. Probá con otro curso o cambiá el filtro.</p>
    <button class="demo-link" data-session-reset>Ver todos los grupos</button>
  </div>
  <noscript><p class="session-noscript">Esta vista muestra los grupos seleccionados. Para cambiar los filtros o probar la inscripción necesitás JavaScript.</p></noscript>
</section>

<script is:inline>
(() => {
  function focusFilter(picker) {
    const filter = picker.querySelector('.session-filters label:not(.session-filter-hidden) select');
    const heading = picker.querySelector('h2');
    if (filter) filter.focus({ preventScroll: true });
    else if (heading) { heading.tabIndex = -1; heading.focus({ preventScroll: true }); }
  }

  function filterSessions(picker) {
    const course = picker.querySelector('[data-session-course]');
    const group = picker.querySelector('[data-session-group]');
    let count = 0;
    picker.querySelectorAll('[data-session-row]').forEach((row) => {
      const visible = (course.value === 'todos' || row.dataset.course === course.value) && (group.value === 'todos' || row.dataset.group === group.value);
      row.hidden = !visible;
      if (visible) count++;
    });
    picker.querySelector('[data-session-count]').textContent = `${count} ${count === 1 ? 'grupo' : 'grupos'}`;
    picker.querySelector('[data-session-empty]').hidden = count > 0;
  }

  document.querySelectorAll('[data-session-picker]').forEach((picker) => {
    picker.addEventListener('change', () => filterSessions(picker));
    picker.querySelector('[data-session-reset]')?.addEventListener('click', () => {
      picker.querySelectorAll('select').forEach((select) => { select.value = 'todos'; });
      filterSessions(picker);
      focusFilter(picker);
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('[data-select-course],[data-select-group]') : null;
    if (!target) return;
    const picker = document.querySelector('[data-session-picker]');
    if (!picker) return;
    const course = picker.querySelector('[data-session-course]');
    const group = picker.querySelector('[data-session-group]');
    course.value = target.dataset.selectCourse || 'todos';
    group.value = target.dataset.selectGroup || 'todos';
    filterSessions(picker);
    requestAnimationFrame(() => focusFilter(picker));
  });
})();
</script>

<style>
  .session-picker { scroll-margin-top: 24px; }
  .session-heading h2 { margin: 0; font-family: var(--demo-display); font-size: clamp(1.6rem, 3vw, 2.3rem); font-weight: 650; line-height: 1.15; letter-spacing: -.025em; }
  .session-heading p { margin: 10px 0 0; color: var(--demo-muted); font-size: .9rem; }
  .session-filters { display: flex; flex-wrap: wrap; align-items: end; gap: 20px; margin-block: 24px 16px; }
  .session-filters label { display: grid; flex: 1 1 180px; gap: 7px; font-size: .85rem; font-weight: 600; }
  .session-filters .session-filter-hidden { display: none; }
  select { width: 100%; min-height: 48px; padding: 10px 32px 10px 12px; border: 1px solid var(--demo-line); border-radius: 4px; background: var(--demo-paper); color: var(--demo-ink); font: inherit; }
  .session-count { margin: 0; padding-block: 12px; color: var(--demo-muted); font-size: .85rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .session-list { list-style: none; margin: 0; padding: 0; }
  .session-row { display: grid; grid-template-columns: 1.1fr 1fr 1fr auto; align-items: center; gap: 20px; padding-block: 20px; border-top: 1px solid var(--demo-line); }
  .session-row[hidden] { display: none; }
  .session-course h3 { margin: 0 0 5px; font: 650 1rem/1.3 var(--demo-body); }
  .session-course span, .session-meta span, .session-date span { display: block; color: var(--demo-muted); font-size: .85rem; }
  .session-meta strong, time { display: block; font-size: .88rem; font-weight: 500; }
  .session-enroll { display: grid; justify-items: end; gap: 7px; }
  .session-enroll > span { font-size: 1rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .session-enroll small { color: var(--demo-muted); font-size: .8rem; font-weight: 400; }
  .session-enroll .demo-button { padding: 10px 16px; white-space: nowrap; }
  .session-empty { padding: 24px; background: var(--demo-soft); }
  .session-empty p { margin: 0 0 12px; }
  .session-empty[hidden] { display: none; }
  .session-noscript { font-size: .9rem; }
  @media (max-width: 900px) {
    .session-row { grid-template-columns: 1fr 1fr; gap: 12px 20px; }
    .session-enroll { grid-column: 2; grid-row: 1 / span 3; }
    .session-meta, .session-date { grid-column: 1; }
  }
  @media (max-width: 430px) {
    .session-row { grid-template-columns: 1fr; }
    .session-enroll { grid-column: 1; grid-row: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 4px; }
    .session-enroll .demo-button { white-space: normal; }
    .session-filters { gap: 12px; }
    .session-filters label { flex-basis: 100%; }
    .session-count { padding-block: 0; }
  }
</style>
