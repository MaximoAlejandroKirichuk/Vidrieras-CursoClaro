---
interface Props {
  id: string;
  name: string;
  category: string;
  summary: string;
  description: string;
  interactions: string[];
  first?: boolean;
  reverse?: boolean;
}

const { id, name, category, summary, description, interactions, first = false, reverse = false } = Astro.props;
const href = `/${id}`;
---
<article id={id} class:list={['project', `project-${id}`, { 'project-reverse': reverse }]} aria-labelledby={`${id}-title`}>
  <a class="project-preview" href={href}>
    <img
      src={`./previews/${id}-1200.webp`}
      srcset={`./previews/${id}-600.webp 600w, ./previews/${id}-1200.webp 1200w`}
      sizes="(min-width: 1280px) 760px, (min-width: 800px) 60vw, calc(100vw - 48px)"
      width="1200" height="860" alt=""
      loading={first ? 'eager' : 'lazy'}
      fetchpriority={first ? 'high' : 'auto'}
      decoding="async"
    />
    <span class="preview-caption">Vista de la demo <span>Explorar {name}</span></span>
  </a>
  <div class="project-copy">
    <h2 id={`${id}-title`}>{name}</h2>
    <p class="project-category">{category}</p>
    <h3>{summary}</h3>
    <p class="project-description">{description}</p>
    <details class="project-interactions">
      <summary>Qué podés probar</summary>
      <ul>{interactions.map((interaction) => <li>{interaction}</li>)}</ul>
    </details>
    <a class="project-action" href={href} aria-label={`Explorar demo de ${name}`}>Explorar demo<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 5l7 7-7 7" /></svg></a>
  </div>
</article>
